{"caps":[{"text":"One bad change can break your whole app.","start":0.35,"end":2.76,"words":[0.35,0.62,0.82,1.44,1.62,1.82,2.03,2.15]},{"text":"So how do pros add features safely?","start":2.77,"end":5.28,"words":[2.77,2.95,3.11,3.25,3.94,4.19,4.71]},{"text":"That's what branches are for.","start":5.81,"end":7.43,"words":[5.81,6.14,6.64,7.07,7.16]},{"text":"Think of a branch as a second save slot.","start":7.83,"end":10.14,"words":[7.83,8.01,8.12,8.26,8.95,9.09,9.13,9.44,9.66]},{"text":"You experiment there... main stays safe.","start":10.46,"end":13.33,"words":[10.46,10.62,11.11,11.72,12.23,12.84]},{"text":"Your real code lives on the main branch.","start":13.66,"end":16.31,"words":[13.66,13.81,14.14,14.66,15.32,15.49,15.58,15.85]},{"text":"To start something new,","start":16.58,"end":17.6,"words":[16.58,16.66,16.93,17.23]},{"text":"run git switch -c feature.","start":17.87,"end":21.16,"words":[17.87,18.16,18.58,20.15,20.83]},{"text":"Now you're on the feature branch.","start":21.58,"end":23.08,"words":[21.58,22.01,22.21,22.3,22.36,22.76]},{"text":"Every commit lands here...","start":23.28,"end":24.88,"words":[23.28,23.5,24.22,24.6]},{"text":"main doesn't change.","start":25.2,"end":26.49,"words":[25.2,25.54,26.12]},{"text":"Totally broke it?","start":26.96,"end":27.96,"words":[26.96,27.25,27.47]},{"text":"Just delete the branch.","start":27.97,"end":29.25,"words":[27.97,28.47,28.75,28.87]},{"text":"Main is untouched.","start":29.5,"end":30.8,"words":[29.5,29.72,30.28]},{"text":"Feature working?","start":31.08,"end":32.07,"words":[31.08,31.41]},{"text":"Switch back with git switch main,","start":32.08,"end":34.99,"words":[32.08,32.37,32.92,33.4,33.9,34.57]},{"text":"then run git merge feature...","start":35,"end":37.6,"words":[35,35.59,36.09,36.54,37.19]},{"text":"and it's in!","start":37.88,"end":39.09,"words":[37.88,38.32,38.56]},{"text":"Working with a team?","start":39.25,"end":40.01,"words":[39.25,39.53,39.68,39.76]},{"text":"Push your branch and open a pull request,","start":40.02,"end":43.22,"words":[40.02,40.89,41.14,41.79,42.01,42.52,42.63,42.73]},{"text":"so others can review it first.","start":43.6,"end":45.38,"words":[43.6,43.79,44.11,44.56,44.81,44.91]},{"text":"Branch. Commit. Merge.","start":45.65,"end":47.61,"words":[45.65,46.44,47.19]},{"text":"That's the whole idea.","start":47.91,"end":48.77,"words":[47.91,48.19,48.28,48.46]},{"text":"Next up: merge conflicts.","start":49.12,"end":50.78,"words":[49.12,49.39,49.93,50.23]},{"text":"If this helped,","start":51.04,"end":51.82,"words":[51.04,51.16,51.33]},{"text":"follow along for more.","start":51.83,"end":52.72,"words":[51.83,52.14,52.29,52.42]}],"end":52.72}