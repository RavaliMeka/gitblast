{"caps":[{"text":"One bad change can break your whole app.","start":0.43,"end":3.13,"words":[0.43,0.69,0.9,1.54,1.74,1.95,2.37,2.66]},{"text":"So how do pros add features safely?","start":3.14,"end":5.77,"words":[3.14,3.29,3.46,3.59,4.27,4.67,5.25]},{"text":"That's what branches are for.","start":6.28,"end":8.22,"words":[6.28,6.7,7.33,7.76,7.84]},{"text":"Think of a branch as a second save slot.","start":8.38,"end":10.23,"words":[8.38,8.54,8.63,8.77,9.3,9.44,9.47,9.76,9.94]},{"text":"You experiment there... main stays safe.","start":10.68,"end":13.26,"words":[10.68,10.84,11.32,11.95,12.48,12.87]},{"text":"Your real code lives on the main branch.","start":13.65,"end":16.35,"words":[13.65,13.83,14.07,14.7,15.41,15.57,15.64,15.89]},{"text":"To start something new,","start":16.6,"end":17.86,"words":[16.6,16.69,16.97,17.27]},{"text":"run git switch -c feature.","start":17.87,"end":21.42,"words":[17.87,18.71,19.02,20.37,20.73]},{"text":"Now you're on the feature branch.","start":21.82,"end":23.93,"words":[21.82,22.41,22.67,22.8,23.16,23.56]},{"text":"Every commit lands here...","start":24.33,"end":25.8,"words":[24.33,24.57,25.14,25.52]},{"text":"main doesn't change.","start":26.27,"end":27.7,"words":[26.27,26.97,27.24]},{"text":"Totally broke it?","start":27.91,"end":28.94,"words":[27.91,28.21,28.42]},{"text":"Just delete the branch.","start":28.95,"end":30.34,"words":[28.95,29.56,29.87,29.97]},{"text":"Main is untouched.","start":30.8,"end":32.15,"words":[30.8,31.01,31.59]},{"text":"Feature working?","start":32.5,"end":33.45,"words":[32.5,32.86]},{"text":"Switch back with git switch main,","start":33.46,"end":36.71,"words":[33.46,33.76,34.42,34.86,35.14,35.92]},{"text":"then run git merge feature...","start":36.72,"end":39.27,"words":[36.72,37.02,37.52,38.06,38.72]},{"text":"and it's in!","start":39.49,"end":40.31,"words":[39.49,39.73,39.95]},{"text":"Working with a team?","start":40.56,"end":41.48,"words":[40.56,40.88,41,41.08]},{"text":"Push your branch and open a pull request,","start":41.98,"end":44.68,"words":[41.98,42.15,42.34,42.91,43.24,43.83,43.89,44.06]},{"text":"so others can review it first.","start":44.69,"end":46.61,"words":[44.69,44.87,45.17,45.59,45.77,45.87]},{"text":"Branch. Commit. Merge.","start":46.62,"end":48.48,"words":[46.62,47.34,48.04]},{"text":"That's the whole idea.","start":48.72,"end":49.72,"words":[48.72,49.05,49.18,49.37]},{"text":"Next up: merge conflicts.","start":50.01,"end":51.48,"words":[50.01,50.27,50.7,51]},{"text":"If this helped,","start":51.49,"end":52.41,"words":[51.49,51.65,51.94]},{"text":"follow along for more.","start":52.42,"end":53.17,"words":[52.42,52.63,52.81,52.96]}],"end":53.17}